# Copy this file to .env.local for local development.

# Required for the AI Tutor (src/app/api/tutor/route.ts). Get this from
# platform.openai.com. The tutor endpoint returns a clear 500 instead of
# crashing the build if this isn't set - it just won't respond until it is.
OPENAI_API_KEY=

# Optional - defaults to gpt-4o-mini if unset.
TUTOR_MODEL=gpt-4o-mini

# Required for the leaderboard API (src/app/api/leaderboard/route.ts) and its
# rate limiter, and now also the AI tutor's rate limiter. Get these from an
# Upstash Redis database - either directly at upstash.com (free tier), or via
# the Vercel dashboard's Storage tab -> Marketplace Database Integrations ->
# Upstash -> Redis, which provisions one and can inject these same two values
# into your Vercel project automatically.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
