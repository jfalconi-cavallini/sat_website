# Copy this file to .env.local for local development.

# Base URL of the AI Tutor backend (backend/flask_api.py). Defaults to
# http://localhost:5050/chat if unset, matching that service's own default port.
NEXT_PUBLIC_CHATBOT_URL=http://localhost:5050/chat

# Required for the leaderboard API (src/app/api/leaderboard/route.ts) and its
# rate limiter. Get these from an Upstash Redis database - either directly at
# upstash.com (free tier), or via the Vercel dashboard's Storage tab ->
# Marketplace Database Integrations -> Upstash -> Redis, which provisions one
# and can inject these same two values into your Vercel project automatically.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
