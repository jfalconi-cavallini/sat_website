# Copy this file to backend/.env and fill in real values.
# flask_api.py loads this automatically via python-dotenv.

# Required: your OpenAI API key (used by chatbot.py's OpenAI() client)
OPENAI_API_KEY=

# Required: path to a CSV dataset shaped for SATChatbot (see the `needed`
# columns list in chatbot.py, especially `choices` as
# [{'letter': 'A', 'text': '...'}] and `correct`). The repo's own
# data/math_qa_normalized.csv and data/english_qa_normalized.csv are NOT
# yet compatible as-is — see the note in flask_api.py above CSV_PATH.
SATBOT_CSV=

# Optional overrides (defaults shown)
SAT_BOT_MODEL=gpt-4o-mini
PORT=5050
SATBOT_CORS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000
